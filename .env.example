# Copy to .env and replace this development-only example password.
# This one value configures the container and the local Go commands.
# Use single quotes for a password containing $ or spaces, for example 'a$b c'.
POSTGRES_USER=scigraph
POSTGRES_PASSWORD=change-me-locally
PG_PORT=5432

# Optional settings read by the Go commands from .env.
HTTP_ADDR=127.0.0.1:8080
HTTP_READ_TIMEOUT=5s
HTTP_WRITE_TIMEOUT=10s
HTTP_IDLE_TIMEOUT=60s
DB_CONNECT_TIMEOUT=3s
DB_PING_TIMEOUT=3s

# The probe and importer also read this file. Keyless runs are limited to 10 works.
# .env is ignored by Git; never print a real API key in logs.
OPENALEX_BASE_URL=https://api.openalex.org
OPENALEX_API_KEY=
OPENALEX_TIMEOUT=10s
