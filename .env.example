# Copy to .env and replace this development-only example password.
# POSTGRES_PASSWORD initializes a new database volume; editing it later does
# not change the password of an existing PostgreSQL role.
POSTGRES_USER=scigraph
POSTGRES_PASSWORD=change-me-locally
PG_PORT=5432

# Export these in the shell before make run; Go does not load .env automatically.
# Match the user, password, and port above if you change them.
HTTP_ADDR=127.0.0.1:8080
DATABASE_URL=postgres://scigraph:change-me-locally@127.0.0.1:5432/scigraph?sslmode=disable
HTTP_READ_TIMEOUT=5s
HTTP_WRITE_TIMEOUT=10s
HTTP_IDLE_TIMEOUT=60s
DB_CONNECT_TIMEOUT=3s
DB_PING_TIMEOUT=3s

# The probe and importer read these from the shell. Keyless runs are limited to 10 works.
# Never commit a real API key to .env or print it in logs.
OPENALEX_BASE_URL=https://api.openalex.org
OPENALEX_API_KEY=
OPENALEX_TIMEOUT=10s
